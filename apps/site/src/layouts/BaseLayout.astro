---
import '../styles/global.css';

import { Layers, Menu } from 'lucide-react';

import { ThemeToggle } from '../components/ThemeToggle';
import { APP_URL, FOOTER_NAV, NAV } from '../site';

interface Props {
  title: string;
  description?: string;
  /** Full-width content (the landing page draws its own grid). */
  wide?: boolean;
}

const {
  title,
  description = 'Interactive, editable architecture and flow diagrams.',
  wide = false,
} = Astro.props;
const pageTitle = title === 'Sododeck' ? title : `${title} · Sododeck`;
const gutters = 'px-6 tab:px-8 desk:px-[max(40px,calc((100%-1200px)/2))]';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply the theme before paint to avoid a flash.
      try {
        const stored = localStorage.getItem('sododeck:theme');
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas text-ink">
    <header
      class={`sticky top-0 z-50 flex h-16 items-center gap-2.5 border-b border-hairline bg-canvas tab:gap-8 ${gutters}`}
    >
      <a href="/" class="flex flex-none items-center gap-[9px] rounded-[9px]">
        <img src="/favicon.svg" alt="" width="28" height="28" aria-hidden="true" />
        <span class="text-[16px] font-semibold tracking-[-0.01em] text-ink">Sododeck</span>
      </a>
      <nav aria-label="Main" class="hidden items-center gap-7 tab:flex">
        {NAV.map((item) => (
          <a href={item.href} class="text-[14px] text-ink-secondary hover:text-ink">
            {item.label}
          </a>
        ))}
      </nav>
      <div class="flex-1"></div>
      <div class="hidden tab:block">
        <ThemeToggle client:load />
      </div>
      <a href={APP_URL} class="ld-btn ld-btn-secondary ld-btn-sm">
        Open app
      </a>
      <details class="relative tab:hidden">
        <summary
          class="flex size-9 cursor-pointer list-none items-center justify-center rounded-[10px] border-[1.5px] border-border-strong bg-surface text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu size={17} strokeWidth={2} aria-hidden="true" />
        </summary>
        <div class="absolute top-11 right-0 flex w-52 flex-col gap-1 rounded-2xl border-[1.5px] border-border-strong bg-surface p-2 shadow-float">
          {NAV.map((item) => (
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-[14px] text-ink-secondary hover:bg-surface-2 hover:text-ink"
            >
              {item.label}
            </a>
          ))}
          <div class="flex items-center justify-between px-3 py-1 text-[14px] text-ink-secondary">
            Theme
            <ThemeToggle client:load />
          </div>
        </div>
      </details>
    </header>
    <main class={wide ? 'flex-1' : 'mx-auto w-full max-w-5xl flex-1 px-6 py-12'}>
      <slot />
    </main>
    <footer
      class={`flex flex-col items-start gap-5 border-t border-hairline pt-8 pb-10 tab:flex-row tab:items-center tab:gap-8 ${gutters}`}
    >
      <a href="/" class="flex flex-none items-center gap-[9px]">
        <span
          class="flex size-7 items-center justify-center rounded-[9px] bg-inverse text-on-inverse"
          aria-hidden="true"
        >
          <Layers size={16} strokeWidth={2} />
        </span>
        <span class="text-[16px] font-semibold tracking-[-0.01em] text-ink">Sododeck</span>
      </a>
      <nav aria-label="Footer" class="flex flex-wrap gap-4 tab:gap-6">
        {FOOTER_NAV.map((item) => (
          <a href={item.href} class="text-[13.5px] text-ink-secondary hover:text-ink">
            {item.label}
          </a>
        ))}
      </nav>
      <div class="flex-1"></div>
      <span class="text-[13px] text-ink-muted">© {new Date().getFullYear()} Sododeck</span>
    </footer>
  </body>
</html>
