{
  "$schema": "https://sododeck.com/schema/v1.json",
  "version": 1,
  "name": "Logistics Delivery",
  "description": "Last-mile delivery platform.\n\n- Orders, pricing, dispatch\n- Tracks every parcel",
  "tags": ["logistics"],
  "nodes": [
    {
      "id": "app",
      "type": "client",
      "title": "Customer App",
      "tech": "React Native",
      "group": "clients",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "gw",
      "type": "gateway",
      "title": "API Gateway",
      "tech": "Envoy",
      "group": "edge",
      "position": {
        "x": 260,
        "y": 0
      }
    },
    {
      "id": "order",
      "type": "service",
      "title": "Order Service",
      "tech": "Go",
      "group": "core",
      "position": {
        "x": 520,
        "y": 0
      },
      "owner": "Orders",
      "tags": ["critical", "pii"],
      "description": "Owns the order lifecycle from checkout to delivery.\n\n- Validates cart and address\n- Requests a quote and a payment authorization\n- Emits `order.created` on success",
      "links": [
        {
          "label": "Runbook",
          "url": "https://notion.so/acme/order-runbook"
        },
        {
          "label": "Repository",
          "url": "https://github.com/acme/order-service"
        }
      ],
      "rules": ["tier"]
    },
    {
      "id": "pricing",
      "type": "service",
      "title": "Pricing Service",
      "tech": "Python",
      "group": "core",
      "position": {
        "x": 780,
        "y": -100
      },
      "owner": "Orders",
      "tags": ["critical", "pci"]
    },
    {
      "id": "payment",
      "type": "service",
      "title": "Payment Service",
      "tech": "Java",
      "group": "core",
      "position": {
        "x": 780,
        "y": 60
      },
      "owner": "Payments",
      "tags": ["critical"]
    },
    {
      "id": "dispatch",
      "type": "service",
      "title": "Dispatch Service",
      "tech": "Go",
      "group": "core",
      "position": {
        "x": 780,
        "y": 220
      },
      "owner": "Dispatch",
      "tags": ["core"]
    },
    {
      "id": "route",
      "type": "service",
      "title": "Route Optimizer",
      "tech": "Python",
      "group": "core",
      "position": {
        "x": 1040,
        "y": 220
      }
    },
    {
      "id": "db",
      "type": "database",
      "title": "Orders DB",
      "tech": "PostgreSQL 16",
      "group": "data",
      "position": {
        "x": 1040,
        "y": -100
      }
    }
  ],
  "groups": [
    {
      "id": "clients",
      "title": "Clients"
    },
    {
      "id": "edge",
      "title": "Edge"
    },
    {
      "id": "core",
      "title": "Core services"
    },
    {
      "id": "data",
      "title": "Data"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "app",
      "to": "gw",
      "label": "HTTPS",
      "protocol": "http"
    },
    {
      "id": "e2",
      "from": "gw",
      "to": "order",
      "label": "POST /orders",
      "protocol": "http"
    },
    {
      "id": "e3",
      "from": "order",
      "to": "pricing",
      "label": "quote",
      "protocol": "grpc"
    },
    {
      "id": "e5",
      "from": "order",
      "to": "payment",
      "label": "authorize",
      "protocol": "grpc",
      "owner": "Payments",
      "tags": ["pci", "sync"],
      "description": "Reserves the card amount before the order is stored.\n\n- Idempotency key: `order_id`\n- Timeout 800 ms, no retries",
      "links": [
        {
          "label": "API contract",
          "url": "https://github.com/acme/payment-api"
        }
      ]
    },
    {
      "id": "e6",
      "from": "order",
      "to": "db",
      "label": "INSERT",
      "protocol": "sql"
    },
    {
      "id": "e7",
      "from": "order",
      "to": "dispatch",
      "label": "order.created",
      "protocol": "event"
    },
    {
      "id": "e8",
      "from": "dispatch",
      "to": "route",
      "label": "route",
      "protocol": "grpc"
    }
  ],
  "views": [],
  "features": [
    {
      "id": "delivery",
      "title": "Delivery",
      "owner": "Orders"
    }
  ],
  "flows": [
    {
      "id": "place",
      "title": "Place order",
      "feature": "delivery",
      "owner": "Orders",
      "tags": ["checkout"],
      "description": "A customer places an order and gets a delivery quote.",
      "links": [
        {
          "label": "Product brief",
          "url": "https://notion.so/acme/place-order"
        }
      ],
      "steps": [
        {
          "id": "s1",
          "edge": "e1",
          "title": "Submit order"
        },
        {
          "id": "s2",
          "edge": "e2"
        },
        {
          "id": "s3",
          "edge": "e5",
          "title": "Authorize payment"
        },
        {
          "id": "s4",
          "edge": "e3",
          "title": "Quote the delivery",
          "owner": "Orders",
          "sla": "< 120 ms",
          "tags": ["quote"],
          "rules": ["tier"],
          "ruleInputs": {
            "tier": {
              "dist": "5",
              "weight": "10",
              "prio": "Express"
            }
          },
          "description": "Pricing picks the vehicle tier."
        },
        {
          "id": "s5",
          "edge": "e6"
        }
      ]
    },
    {
      "id": "assign",
      "title": "Assign driver",
      "feature": "delivery",
      "steps": [
        {
          "id": "a1",
          "edge": "e7"
        },
        {
          "id": "a2",
          "edge": "e8",
          "rules": ["tier"]
        }
      ]
    }
  ],
  "rules": {
    "tier": {
      "title": "Delivery tier",
      "description": "Picks vehicle, SLA and surcharge from distance, weight and priority.",
      "hitPolicy": "first",
      "inputs": [
        {
          "id": "dist",
          "label": "Distance (km)"
        },
        {
          "id": "weight",
          "label": "Weight (kg)"
        },
        {
          "id": "prio",
          "label": "Priority"
        }
      ],
      "outputs": [
        {
          "id": "veh",
          "label": "Vehicle"
        },
        {
          "id": "sla",
          "label": "SLA"
        },
        {
          "id": "fee",
          "label": "Surcharge"
        }
      ],
      "rows": [
        {
          "id": "r1",
          "when": ["≤ 5", "≤ 10", "Express"],
          "then": ["Bike", "45 min", "€4.00"]
        },
        {
          "id": "r2",
          "when": ["≤ 5", "≤ 10", "Standard"],
          "then": ["Bike", "2 h", "€0.00"]
        },
        {
          "id": "r3",
          "when": ["≤ 20", "≤ 30", "Any"],
          "then": ["Van", "4 h", "€2.50"]
        },
        {
          "id": "r4",
          "when": ["> 20", "≤ 30", "Any"],
          "then": ["Van", "Next day", "€6.00"]
        },
        {
          "id": "r5",
          "when": ["Any", "> 30", "Any"],
          "then": ["Truck", "Next day", "€12.00"]
        }
      ]
    },
    "reattempt": {
      "title": "Reattempt policy",
      "hitPolicy": "first",
      "inputs": [
        {
          "id": "tries",
          "label": "Attempts"
        },
        {
          "id": "reason",
          "label": "Reason"
        }
      ],
      "outputs": [
        {
          "id": "act",
          "label": "Action"
        }
      ],
      "rows": [
        {
          "id": "q1",
          "when": ["< 2", "Not home"],
          "then": ["Retry tomorrow"]
        },
        {
          "id": "q2",
          "when": ["< 3", "Address, Access"],
          "then": ["Call customer"]
        },
        {
          "id": "q3",
          "when": ["", "> abc"],
          "then": ["Return to depot"]
        }
      ]
    }
  },
  "stickies": []
}
