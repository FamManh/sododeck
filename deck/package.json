{
  "name": "deck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@arcjet/next": "1.10.0",
    "@hookform/resolvers": "5.9.1",
    "@logtape/logtape": "2.3.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "next": "16.3.1",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "translation-resilience": "0.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.14.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/prompt-cli": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
