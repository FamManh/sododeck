{
  "$schema": "https://sododeck.com/schema/v1.json",
  "version": 1,
  "name": "Delivery platform",
  "description": "Top level: apps and the platform. Open the platform card to see its services.",
  "nodes": [
    { "id": "customer-app", "type": "client", "title": "Customer App", "level": "system" },
    { "id": "courier-app", "type": "client", "title": "Courier App", "level": "system" },
    {
      "id": "platform",
      "type": "service",
      "title": "Delivery Platform",
      "level": "system",
      "description": "Everything that runs on our side. Open it for the services."
    },
    { "id": "maps", "type": "external", "title": "Maps API", "level": "system" },
    { "id": "api", "type": "gateway", "title": "Public API", "group": "edge", "parent": "platform" },
    { "id": "dispatch", "type": "service", "title": "Dispatch", "group": "core", "parent": "platform" },
    { "id": "tracking", "type": "service", "title": "Tracking", "group": "core", "parent": "platform" },
    { "id": "jobs", "type": "queue", "title": "Job Queue", "group": "data", "parent": "platform" },
    { "id": "deliveries-db", "type": "database", "title": "Deliveries DB", "group": "data", "parent": "platform" }
  ],
  "groups": [
    { "id": "edge", "title": "Edge" },
    { "id": "core", "title": "Core services" },
    { "id": "data", "title": "Data" }
  ],
  "edges": [
    { "id": "customer-platform", "from": "customer-app", "to": "platform", "protocol": "http", "label": "orders, tracking" },
    { "id": "courier-platform", "from": "courier-app", "to": "platform", "protocol": "websocket", "label": "location, jobs" },
    { "id": "platform-maps", "from": "platform", "to": "maps", "protocol": "http", "label": "routes, ETAs" },
    { "id": "api-dispatch", "from": "api", "to": "dispatch", "protocol": "grpc", "label": "new delivery" },
    { "id": "dispatch-jobs", "from": "dispatch", "to": "jobs", "protocol": "event", "label": "JobOffered" },
    { "id": "jobs-tracking", "from": "jobs", "to": "tracking", "protocol": "event", "label": "JobAccepted" },
    { "id": "tracking-db", "from": "tracking", "to": "deliveries-db", "protocol": "sql", "label": "positions" },
    { "id": "api-tracking", "from": "api", "to": "tracking", "protocol": "grpc", "label": "where is my order" }
  ],
  "views": [],
  "features": [{ "id": "dispatch", "title": "Dispatch" }],
  "flows": [
    {
      "id": "assign-courier",
      "title": "Assign a courier",
      "feature": "dispatch",
      "steps": [
        { "id": "new-delivery", "edge": "api-dispatch", "title": "New delivery" },
        { "id": "offer", "edge": "dispatch-jobs", "title": "Offer the job" },
        { "id": "accept", "edge": "jobs-tracking", "title": "Courier accepts" },
        { "id": "track", "edge": "tracking-db", "title": "Start tracking" }
      ]
    }
  ],
  "rules": {},
  "stickies": []
}
