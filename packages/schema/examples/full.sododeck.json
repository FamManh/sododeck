{
  "$schema": "https://sododeck.com/schema/v1.json",
  "version": 1,
  "name": "Logistics Delivery (excerpt)",
  "description": "Last-mile delivery: ordering, dispatch and payment. Uses every object type and field of format v1.",
  "tags": ["logistics", "example"],
  "swatches": ["#7a3cff", "#1f2a44"],
  "tagColors": { "Lan": "#7a3cff", "PCI": "violet" },
  "packs": ["architecture", "process", "logistics", "data", "database"],
  "fields": [
    {
      "id": "warehouse.capacity",
      "name": "Capacity",
      "kind": "progress",
      "types": ["warehouse"],
      "onCard": true
    },
    {
      "id": "warehouse.sla",
      "name": "SLA",
      "kind": "number",
      "types": ["warehouse"],
      "onCard": true,
      "unit": "h"
    },
    {
      "id": "warehouse.region",
      "name": "Region",
      "kind": "select",
      "types": ["warehouse"],
      "onCard": true,
      "options": [
        { "id": "o_south", "label": "South", "color": "amber" },
        { "id": "o_north", "label": "North", "color": "#2f6fde" },
        { "id": "o_east", "label": "East" }
      ]
    },
    {
      "id": "f_stage",
      "name": "Stage",
      "kind": "status",
      "types": ["warehouse"],
      "onCard": true,
      "options": [
        { "id": "s_plan", "label": "Planned", "color": "slate", "icon": "circle" },
        { "id": "s_draft", "label": "Draft", "icon": "circle-dashed" },
        { "id": "s_build", "label": "Building", "color": "blue", "icon": "circle-dot" },
        { "id": "s_review", "label": "In review", "color": "violet", "icon": "eye" },
        { "id": "s_live", "label": "Live", "color": "green", "icon": "circle-check" },
        { "id": "s_closed", "label": "Closed", "icon": "door-open" }
      ]
    },
    { "id": "f_manager", "name": "Manager", "kind": "person", "types": ["warehouse"] },
    { "id": "f_opened", "name": "Opened", "kind": "date", "types": ["warehouse"] },
    { "id": "f_audit", "name": "Audit window", "kind": "dateRange", "types": ["warehouse"] },
    { "id": "f_runbook", "name": "Runbook", "kind": "link", "types": ["warehouse", "service"] },
    { "id": "f_notes", "name": "Notes", "kind": "text" },
    { "id": "owner", "name": "Owner", "kind": "person", "onCard": true }
  ],
  "fieldDefaults": ["warehouse"],
  "dialect": "postgres",
  "enums": [
    {
      "id": "enum-customer-status",
      "name": "customer_status",
      "schema": "public",
      "note": "Account state of a customer.",
      "color": "violet",
      "values": [
        { "id": "enumval-active", "name": "active", "note": "Can place orders." },
        { "id": "enumval-blocked", "name": "blocked" }
      ]
    },
    {
      "id": "enum-order-status",
      "name": "order_status",
      "color": "#d97706",
      "values": [
        { "id": "enumval-pending", "name": "pending", "note": "Awaiting payment." },
        { "id": "enumval-paid", "name": "paid" },
        { "id": "enumval-shipped", "name": "shipped" },
        { "id": "enumval-cancelled", "name": "cancelled" }
      ]
    }
  ],
  "tableDisplay": {
    "detail": "all",
    "hideTypes": false,
    "hideNullable": false,
    "hideNotes": false,
    "hideIndexes": false
  },
  "relationshipDisplay": { "hideEnds": false, "labels": "always", "notation": "numeric" },
  "groupingMode": "schema",
  "nodes": [
    {
      "id": "payments-provider",
      "type": "external",
      "title": "Payments Provider",
      "level": "landscape",
      "description": "Card authorization and capture.",
      "owner": "Finance",
      "tags": ["pci"],
      "tech": "REST",
      "host": "SaaS",
      "icon": "lucide:credit-card",
      "links": [{ "label": "Status page", "url": "https://status.example.com" }],
      "group": "external",
      "position": { "x": 900, "y": 360 },
      "size": { "width": 200, "height": 72 },
      "style": { "fill": "red" }
    },
    {
      "id": "delivery-platform",
      "type": "service",
      "title": "Delivery Platform",
      "level": "system",
      "description": "Everything the delivery team runs.",
      "owner": "Delivery",
      "position": { "x": 460, "y": -120 },
      "style": { "fill": "orange", "stroke": "indigo" },
      "locked": true
    },
    {
      "id": "customer-app",
      "type": "client",
      "title": "Customer App",
      "level": "container",
      "description": "Mobile app where customers **order and track** deliveries.",
      "owner": "Mobile",
      "tags": ["ios", "android"],
      "tech": "React Native",
      "host": "App stores",
      "icon": "smartphone",
      "links": [{ "url": "docs/customer-app.md" }],
      "group": "clients",
      "position": { "x": 40, "y": 80 },
      "style": { "fill": "#7a3cff" }
    },
    {
      "id": "api-gateway",
      "type": "gateway",
      "title": "API Gateway",
      "level": "container",
      "tech": "Envoy",
      "host": "EKS eu-west-1",
      "group": "edge",
      "position": { "x": 250, "y": 140 },
      "style": { "fill": "yellow" }
    },
    {
      "id": "order-svc",
      "type": "service",
      "title": "Order Service",
      "level": "container",
      "description": "Owns the order lifecycle.",
      "owner": "Ordering",
      "tags": ["core"],
      "tech": "Go",
      "host": "EKS eu-west-1",
      "icon": "receipt-text",
      "links": [{ "label": "Repository", "url": "https://git.example.com/order-svc" }],
      "group": "core",
      "parent": "delivery-platform",
      "rules": ["delivery-tier"],
      "position": { "x": 460, "y": 80.5 },
      "style": { "fill": "lime", "stroke": "violet" }
    },
    {
      "id": "order-validator",
      "type": "service",
      "title": "Order Validator",
      "level": "component",
      "parent": "order-svc",
      "position": { "x": 460, "y": 200 },
      "style": { "fill": "green" }
    },
    {
      "id": "dispatch-svc",
      "type": "service",
      "title": "Dispatch Service",
      "level": "container",
      "tech": "Kotlin",
      "host": "EKS eu-west-1",
      "group": "core",
      "parent": "delivery-platform",
      "position": { "x": 660, "y": 80 },
      "style": { "fill": "teal" }
    },
    {
      "id": "order-events",
      "type": "queue",
      "title": "Order Events",
      "tech": "Kafka",
      "host": "MSK",
      "group": "messaging",
      "position": { "x": 560, "y": 480 },
      "style": { "fill": "cyan" }
    },
    {
      "id": "orders-db",
      "type": "database",
      "display": "shape",
      "title": "Orders DB",
      "tech": "Postgres 16",
      "host": "RDS",
      "group": "data",
      "position": { "x": 900, "y": 80 },
      "style": { "fill": "blue", "stroke": "#1f2a44" }
    },
    {
      "id": "fulfilment-hub",
      "type": "warehouse",
      "title": "Fulfilment hub",
      "owner": "Minh Tran",
      "values": {
        "f_audit": { "from": "2026-10-06", "to": "2026-10-17" },
        "f_manager": "Lan Pham",
        "f_notes": "Bay 4 closed for repairs",
        "f_opened": "2024-03-02",
        "f_runbook": { "url": "https://wiki.example.com/hub", "label": "Hub runbook" },
        "f_stage": "s_live",
        "warehouse.capacity": 82,
        "warehouse.region": "o_south",
        "warehouse.sla": 24
      },
      "position": { "x": 900, "y": 480 }
    },
    {
      "id": "payment-ok",
      "type": "diamond",
      "title": "Payment OK?",
      "position": { "x": 1240, "y": 80 },
      "size": { "width": 176, "height": 112 }
    },
    {
      "id": "shop-db",
      "type": "database",
      "title": "Shop DB",
      "description": "Orders, customers and the catalogue.",
      "position": { "x": 1200, "y": 600 }
    },
    {
      "id": "customers",
      "type": "db-table",
      "title": "customers",
      "description": "People who buy from the shop.",
      "parent": "shop-db",
      "position": { "x": 1200, "y": 680 },
      "schema": "public",
      "columns": [
        { "id": "cust-id", "name": "id", "type": "bigint", "pk": true, "increment": true },
        {
          "id": "cust-email",
          "name": "email",
          "type": "varchar",
          "size": "255",
          "notNull": true,
          "unique": true,
          "check": "email <> ''",
          "note": "Login name."
        },
        {
          "id": "cust-status",
          "name": "status",
          "type": "customer_status",
          "default": "active",
          "enumRef": "enum-customer-status"
        },
        {
          "id": "cust-created",
          "name": "created_at",
          "type": "timestamptz",
          "notNull": true,
          "defaultExpr": "now()"
        }
      ],
      "indexes": [
        {
          "id": "idx-customers-email",
          "name": "customers_email_lower",
          "columns": [{ "expr": "lower(email)" }],
          "unique": true,
          "method": "btree",
          "note": "Case-insensitive login."
        }
      ],
      "detail": "names"
    },
    {
      "id": "orders",
      "type": "db-table",
      "title": "orders",
      "parent": "shop-db",
      "position": { "x": 1480, "y": 680 },
      "columns": [
        { "id": "order-id", "name": "id", "type": "bigint", "pk": true, "increment": true },
        { "id": "order-customer", "name": "customer_id", "type": "bigint", "notNull": true },
        { "id": "order-total", "name": "total", "type": "numeric", "size": "10,2", "default": 0 },
        { "id": "order-paid", "name": "paid", "type": "boolean", "default": false }
      ],
      "indexes": [
        { "id": "idx-orders-customer", "columns": ["order-customer", { "expr": "total desc" }] }
      ],
      "checks": [
        { "id": "chk-orders-total", "name": "orders_total_positive", "expr": "total >= 0" }
      ],
      "expanded": true,
      "detail": "keys"
    },
    {
      "id": "order-items",
      "type": "db-table",
      "title": "order_items",
      "parent": "shop-db",
      "position": { "x": 1760, "y": 680 },
      "columns": [
        { "id": "item-order", "name": "order_id", "type": "bigint", "pk": true },
        { "id": "item-line", "name": "line_no", "type": "integer", "pk": true },
        { "id": "item-qty", "name": "quantity", "type": "integer", "notNull": true }
      ],
      "checks": [{ "id": "chk-items-qty", "expr": "quantity > 0" }],
      "detail": "all"
    },
    {
      "id": "categories",
      "type": "db-table",
      "title": "categories",
      "parent": "shop-db",
      "position": { "x": 1480, "y": 880 },
      "columns": [
        { "id": "cat-id", "name": "id", "type": "bigint", "pk": true },
        { "id": "cat-parent", "name": "parent_id", "type": "bigint" }
      ]
    }
  ],
  "groups": [
    {
      "id": "platform",
      "title": "Platform",
      "description": "Everything we run.",
      "style": { "fill": "amber" }
    },
    {
      "id": "clients",
      "title": "Clients",
      "position": { "x": 16, "y": 56 },
      "size": { "width": 212, "height": 152 },
      "style": { "fill": "pink", "stroke": "slate" }
    },
    { "id": "edge", "title": "Edge", "parent": "platform", "style": { "fill": "#1f2a44" } },
    { "id": "core", "title": "Core services", "parent": "platform" },
    { "id": "messaging", "title": "Messaging", "parent": "platform" },
    { "id": "data", "title": "Data", "parent": "platform" },
    { "id": "external", "title": "External" }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "customer-app",
      "to": "api-gateway",
      "protocol": "http",
      "label": "POST /orders · HTTPS",
      "labelAt": 0.25,
      "direction": "forward",
      "description": "Checkout request with the cart and the delivery address.",
      "owner": "Mobile",
      "tags": ["public"],
      "links": [{ "label": "OpenAPI", "url": "https://api.example.com/openapi.json" }],
      "route": { "fromSide": "right", "toSide": "left", "offset": 40 },
      "style": {
        "shape": "curved",
        "dash": "dashed",
        "width": 3,
        "color": "blue",
        "animated": true
      }
    },
    {
      "id": "e2",
      "from": "api-gateway",
      "to": "order-svc",
      "protocol": "grpc",
      "label": "CreateOrder",
      "route": {
        "fromSide": "bottom",
        "toSide": "top",
        "fromAt": 0.25,
        "toAt": 0.75,
        "waypoints": [
          { "x": 0.5, "dy": -24 },
          { "dx": 12, "y": 0.5 }
        ]
      },
      "style": { "shape": "elbow", "dash": "dotted", "width": 1.5, "color": "#7a3cff" }
    },
    {
      "id": "e3",
      "from": "order-svc",
      "to": "orders-db",
      "protocol": "sql",
      "label": "insert order",
      "style": { "shape": "straight" }
    },
    {
      "id": "e4",
      "from": "order-svc",
      "to": "order-events",
      "protocol": "event",
      "label": "OrderPlaced · Kafka"
    },
    {
      "id": "e5",
      "from": "order-events",
      "to": "dispatch-svc",
      "protocol": "event",
      "label": "OrderPlaced"
    },
    {
      "id": "e6",
      "from": "dispatch-svc",
      "to": "customer-app",
      "protocol": "websocket",
      "label": "driver location",
      "direction": "both"
    },
    {
      "id": "e7",
      "from": "order-svc",
      "to": "payments-provider",
      "protocol": "other",
      "label": "nightly settlement file (SFTP)",
      "direction": "none"
    },
    {
      "id": "rel-orders-customer",
      "from": "orders",
      "to": "customers",
      "label": "placed by",
      "fromColumns": ["order-customer"],
      "toColumns": ["cust-id"],
      "cardinality": "n-1",
      "onDelete": "cascade",
      "onUpdate": "restrict"
    },
    {
      "id": "rel-order-items",
      "from": "orders",
      "to": "order-items",
      "fromColumns": ["order-id"],
      "toColumns": ["item-order"],
      "cardinality": "1-n",
      "onDelete": "set-null",
      "onUpdate": "no-action"
    },
    {
      "id": "rel-category-parent",
      "from": "categories",
      "to": "categories",
      "label": "parent",
      "style": { "color": "teal" },
      "fromColumns": ["cat-id"],
      "toColumns": ["cat-parent"],
      "cardinality": "1-n",
      "toOptional": true,
      "onDelete": "set-default"
    },
    {
      "id": "rel-items-categories",
      "from": "order-items",
      "to": "categories",
      "label": "tagged with",
      "cardinality": "n-n",
      "fromOptional": true
    },
    {
      "id": "rel-customer-latest",
      "from": "customers",
      "to": "orders",
      "label": "latest order",
      "fromColumns": ["cust-id"],
      "toColumns": ["order-customer"],
      "cardinality": "1-1",
      "toOptional": true
    },
    {
      "id": "e-clients-platform",
      "from": "clients",
      "to": "api-gateway",
      "label": "All client traffic",
      "route": { "fromSide": "right", "toSide": "left" }
    }
  ],
  "views": [
    {
      "id": "system",
      "type": "system",
      "title": "System",
      "subtitleField": "tech",
      "collapsed": ["messaging"]
    },
    { "id": "feature", "type": "feature", "title": "Feature", "subtitleField": "flows" },
    {
      "id": "infra",
      "type": "infra",
      "title": "Infra",
      "subtitleField": "host",
      "dimKinds": ["client"],
      "positions": { "orders-db": { "x": 900, "y": 120 } },
      "groupFrames": {
        "data": { "position": { "x": 876, "y": 96 }, "size": { "width": 212, "height": 152 } }
      },
      "pinned": ["orders-db", "api-gateway"]
    },
    {
      "id": "delivery-view",
      "type": "feature",
      "title": "Delivery",
      "subtitleField": "owner",
      "feature": "delivery",
      "includes": ["customer-app", "api-gateway", "order-svc", "orders-db", "order-events"],
      "positions": { "order-svc": { "x": 420, "y": -40 }, "orders-db": { "x": 700, "y": 0 } }
    },
    {
      "id": "custom-1",
      "type": "custom",
      "title": "Custom 1",
      "subtitleField": "none",
      "schemas": ["public"],
      "excludeGroups": ["clients"],
      "excludeKinds": ["external"],
      "excludeTags": ["pci"],
      "detail": "keys"
    }
  ],
  "features": [
    {
      "id": "delivery",
      "title": "Delivery",
      "description": "From checkout to a delivered, paid order.",
      "owner": "Delivery"
    }
  ],
  "flows": [
    {
      "id": "place-order",
      "title": "Place order",
      "feature": "delivery",
      "description": "Checkout to a confirmed, paid order.",
      "trigger": "Customer taps Place order",
      "outcome": "Order is stored and dispatch is notified",
      "owner": "Ordering",
      "tags": ["happy-path"],
      "links": [{ "label": "Runbook", "url": "https://wiki.example.com/place-order" }],
      "steps": [
        {
          "id": "s1",
          "edge": "e1",
          "title": "Submit checkout",
          "condition": "customer taps Place order",
          "sla": "< 150 ms",
          "description": "The app sends the cart.",
          "payload": "{ cartId, addressId, paymentToken }",
          "notes": "Retries are **idempotent** by `cartId`.",
          "owner": "Mobile",
          "tags": ["entry"],
          "links": [{ "label": "Trace", "url": "https://traces.example.com/place-order" }],
          "rules": ["delivery-tier", "notify-channels"],
          "ruleInputs": {
            "delivery-tier": { "distance": "4", "weight": "8", "priority": "Express" },
            "notify-channels": { "priority": "Express" }
          }
        },
        { "id": "s2", "edge": "e2", "condition": "token.valid", "sla": "< 40 ms" },
        { "id": "s3", "edge": "e3", "sla": "< 120 ms" },
        {
          "id": "s4",
          "edge": "e2",
          "title": "Confirm to gateway",
          "condition": "order stored",
          "rules": ["payment-capture"]
        },
        { "id": "s5", "edge": "e4", "sla": "< 2 s" },
        { "id": "s6", "edge": "e5" }
      ]
    },
    { "id": "track-order", "title": "Live tracking", "feature": "delivery", "steps": [] },
    {
      "id": "pay-order",
      "title": "Pay for order",
      "feature": "delivery",
      "branches": [
        {
          "id": "payment-ok",
          "label": "payment ok",
          "condition": "payment.status == \"authorized\""
        },
        {
          "id": "payment-failed",
          "label": "payment failed",
          "condition": "payment.status == \"declined\"",
          "errorPath": true,
          "description": "The order is kept as **unpaid** and the customer is asked again."
        }
      ],
      "steps": [
        { "id": "p1", "edge": "e1" },
        { "id": "p2", "edge": "e2", "title": "Create order" },
        { "id": "p3a", "edge": "e7", "branch": "payment-ok", "title": "Capture payment" },
        { "id": "p3b", "edge": "e4", "branch": "payment-failed" },
        { "id": "p4b", "edge": "e5", "branch": "payment-failed" }
      ]
    }
  ],
  "rules": {
    "delivery-tier": {
      "title": "Delivery tier",
      "description": "Picks vehicle, SLA and surcharge from distance, weight and priority.",
      "hitPolicy": "first",
      "inputs": [
        { "id": "distance", "label": "Distance (km)" },
        { "id": "weight", "label": "Weight (kg)" },
        { "id": "priority", "label": "Priority" }
      ],
      "outputs": [
        { "id": "vehicle", "label": "Vehicle" },
        { "id": "sla", "label": "SLA" },
        { "id": "surcharge", "label": "Surcharge" }
      ],
      "rows": [
        { "id": "r1", "when": ["≤ 5", "≤ 10", "Express"], "then": ["Bike", "45 min", "€4.00"] },
        { "id": "r2", "when": ["≤ 5", "≤ 10", "Standard"], "then": ["Bike", "2 h", "€0.00"] },
        { "id": "r3", "when": ["≤ 20", "≤ 30", "Any"], "then": ["Van", "4 h", "€2.50"] },
        { "id": "r4", "when": ["> 20", "≤ 30", ""], "then": ["Van", "Next day", "€6.00"] },
        { "id": "r5", "when": ["Any", "> 30", "—"], "then": ["Truck", "Next day", "€12.00"] }
      ]
    },
    "payment-capture": {
      "title": "Payment capture",
      "hitPolicy": "unique",
      "inputs": [
        { "id": "status", "label": "Order status" },
        { "id": "amount", "label": "Amount (€)" }
      ],
      "outputs": [
        { "id": "capture", "label": "Capture" },
        { "id": "review", "label": "Review" }
      ],
      "rows": [
        { "id": "r1", "when": ["Delivered", "Any"], "then": ["Full amount", "No"] },
        { "id": "r2", "when": ["Partial", "≤ 200"], "then": ["Pro rata", "No"] },
        { "id": "r3", "when": ["Partial", "> 200"], "then": ["Pro rata", "Finance"] },
        { "id": "r4", "when": ["Failed", "Any"], "then": ["Void", "No"] }
      ]
    },
    "notify-channels": {
      "title": "Notification channels",
      "hitPolicy": "collect",
      "inputs": [{ "id": "priority", "label": "Priority" }],
      "outputs": [{ "id": "channel", "label": "Channel" }],
      "rows": [
        { "id": "push", "when": ["Any"], "then": ["Push"] },
        { "id": "sms", "when": ["Express"], "then": ["SMS"] }
      ]
    }
  },
  "stickies": [
    {
      "id": "note-1",
      "text": "Confirm warehouse SLA with **ops**.",
      "color": "amber",
      "position": { "x": 40, "y": 400 },
      "showInFlows": true
    },
    { "id": "note-2", "text": "Owns PII.", "color": "clay", "anchor": "orders-db" },
    {
      "id": "note-3",
      "text": "Kafka topic retention is 7 days.",
