{
  "name": "sododeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@sododeck/app --filter=@sododeck/site",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "bench": "turbo run bench --filter=@sododeck/app",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "schema:generate": "pnpm --filter @sododeck/schema generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@sododeck/config": "workspace:*",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  }
}
